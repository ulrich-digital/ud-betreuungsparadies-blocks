{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ud-betreuungsparadies/fokus-button",
	"title": "Fokus-Button",
	"category": "design",
	"icon": "megaphone",
	"description": "Gibt einen prominenten Fokus-Button aus. Wahlweise für aktive offene Stellen oder ein eigenes Ziel.",
	"supports": {
		"html": false
	},
	"attributes": {
		"targetType": {
			"type": "string",
			"default": "jobs"
		},
		"text": {
			"type": "string",
			"default": "Offene Stellen"
		},
		"url": {
			"type": "string",
			"default": "/offene-stellen/"
		},
		"gradient": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./editor-script.js",
	"render": "file:./render.php"
}